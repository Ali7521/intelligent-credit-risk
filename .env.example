# AI CreditGuard Environment Configuration

# Server
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development
LOG_LEVEL=INFO

# Database Configuration
# For local PostgreSQL:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/creditguard
# If unset or PostgreSQL is offline, system automatically falls back to local SQLite:
DATABASE_URL=sqlite:///./creditguard.db

# Frontend
VITE_API_URL=http://localhost:8000
